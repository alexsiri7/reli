# Postgres connection string. Required — there is no default, and the service
# refuses to start without it rather than silently using an empty database.
# For the local development database (`docker compose --profile localdb up -d postgres`):
DATABASE_URL=postgresql://reli:reli@localhost:5432/reli

# Bearer token for the MCP endpoint at /mcp. Human-provisioned — pick a long random string
# and put the same value in the claude.ai connector. An empty value is not a dev-mode bypass:
# /mcp answers 401 to every request until this is set.
# MCP_API_TOKEN=

# HTTP Basic password the /api routes behind the web view accept beside the Google sign-in's
# session cookie (any username; this is what curl and the scheduled-pass watchdog send). Human-
# provisioned like MCP_API_TOKEN. An empty value closes nothing that the sign-in below opens, and
# with the sign-in also unset /api answers 401 to everything while /healthz stays green so a
# missing secret cannot roll a deploy back. Stays until a human confirms the sign-in works.
# WEB_UI_PASSWORD=

# Google sign-in for the OAuth 2.1 authorization server at /oauth/*, which a claude.ai connector
# authorises against instead of holding MCP_API_TOKEN. Human-provisioned on the same terms: every
# one defaults to empty, empty closes the sign-in (501 naming what is missing, no JWT accepted)
# and never stops the boot. SECRET_KEY signs the JWTs — at least 32 random bytes, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`. ALLOWED_EMAILS is the
# comma-separated list of Google accounts allowed in; empty admits nobody. GOOGLE_AUTH_REDIRECT_URI
# is https://<host>/api/auth/google/callback, authorised verbatim on the OAuth client below, which
# must be a Web application client for this. RELI_BASE_URL is derived from it when empty.
# SECRET_KEY=
# ALLOWED_EMAILS=
# GOOGLE_AUTH_REDIRECT_URI=
# RELI_BASE_URL=

# Google, for the read-only Calendar and Gmail tools (gmail.readonly, calendar.readonly).
# Human-provisioned: the same Web application OAuth client as the sign-in above. Add
# `http://127.0.0.1:18765/` to its authorised redirect URIs in Google Cloud Console (exact string,
# trailing slash included), then run `uv run python scripts/google_oauth_grant.py` to obtain the
# refresh token. Leaving these unset is safe — Reli boots and the graph tools work; only
# find_correspondence, find_events and check_occurred fail, with a message naming what to set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Logging level
# LOG_LEVEL=INFO

# Sentry error monitoring (optional — empty DSN disables it)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Staging, only for the host that runs docker-compose.staging.yml ---
# Kept distinct from DATABASE_URL so staging never points at production data.
# STAGING_DATABASE_URL=postgresql://reli:CHANGEME@postgres-staging:5432/reli_staging
# STAGING_POSTGRES_PASSWORD=

# Cloudflare Zero Trust tunnel token — host infrastructure, not read by the app.
# Create tunnel at: https://one.dash.cloudflare.com → Networks → Tunnels
# Set the tunnel's public hostname to point to http://reli:8000
CLOUDFLARE_TUNNEL_TOKEN=your_cf_tunnel_token_here
