# Postgres connection string. Required — there is no default, and the service
# refuses to start without it rather than silently using an empty database.
# For the local development database (`docker compose --profile localdb up -d postgres`):
DATABASE_URL=postgresql://reli:reli@localhost:5432/reli

# Bearer token for the MCP endpoint at /mcp. Human-provisioned — pick a long random string
# and put the same value in the claude.ai connector. An empty value is not a dev-mode bypass:
# /mcp answers 401 to every request until this is set.
# MCP_API_TOKEN=

# Password for the read-only web view at / and the /api routes it reads. Human-provisioned like
# MCP_API_TOKEN: the browser prompts for HTTP Basic and any username is accepted. An empty value
# closes the view rather than opening it — / and /api answer 401 until this is set, while /healthz
# stays green so a missing secret cannot roll a deploy back.
# WEB_UI_PASSWORD=

# Google, for the read-only Calendar and Gmail tools (gmail.readonly, calendar.readonly).
# Human-provisioned: create a Desktop app OAuth client in Google Cloud Console, then run
# `uv run python scripts/google_oauth_grant.py` to obtain the refresh token. Leaving these unset
# is safe — Reli boots and the graph tools work; only find_correspondence, find_events and
# check_occurred fail, with a message naming what to set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Logging level
# LOG_LEVEL=INFO

# Sentry error monitoring (optional — empty DSN disables it)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Staging, only for the host that runs docker-compose.staging.yml ---
# Kept distinct from DATABASE_URL so staging never points at production data.
# STAGING_DATABASE_URL=postgresql://reli:CHANGEME@postgres-staging:5432/reli_staging
# STAGING_POSTGRES_PASSWORD=

# Cloudflare Zero Trust tunnel token — host infrastructure, not read by the app.
# Create tunnel at: https://one.dash.cloudflare.com → Networks → Tunnels
# Set the tunnel's public hostname to point to http://reli:8000
CLOUDFLARE_TUNNEL_TOKEN=your_cf_tunnel_token_here
