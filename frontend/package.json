{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:screenshots": "npx playwright test --config playwright.config.ts",
    "test:screenshots:update": "npx playwright test --config playwright.config.ts --update-snapshots",
    "test:smoke": "npx playwright test --config playwright.config.ts --project=smoke",
    "generate:types": "cd .. && python3 scripts/generate_types.py",
    "check:types-fresh": "cd .. && python3 scripts/generate_types.py --check"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
    "fast-uri": ">=3.1.2",
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.9"
  }
}
